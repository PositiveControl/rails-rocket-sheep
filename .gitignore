.idea/
.DS_Store

# Local to a checkout: the driver's state and logs, private settings and notes.
tmp/
.claude/settings.local.json
CLAUDE.local.md

# Agent scratch, as adopt.rb ignores it in an app: task files and segue threads
# are per-developer state, and an untracked one would fail bin/autopilot's
# clean-tree checks after every step.
.llm/tasks/*
!.llm/tasks/task_template.md
.llm/threads/*
!.llm/threads/.gitkeep
