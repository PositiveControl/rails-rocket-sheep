#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/lint-docs — checks that this repo's docs still agree with this repo.
#
# The alignment layer asks an agent to trust what the docs say: that a rule
# exists, that the index routes to it, that a read costs what it claims, that a
# path resolves. Every one of those is a fact about the tree, so every one is
# checkable. Prose that disagrees with the tree is worse than no prose, because
# the agent has no way to tell.
#
# Run it on every edit to templates/docs/rules/, templates/.claude/commands/,
# or any doc that quotes a count:
#
#   bin/lint-docs
#
# Exits 0 when clean, 1 with a list of findings otherwise. Add the marker
# `lint-docs:ignore` to a line that legitimately names a different count.

require "yaml"

ROOT = File.expand_path("..", __dir__)
TEMPLATES = File.join(ROOT, "templates")
RULES_DIR = File.join(TEMPLATES, "docs/rules")
COMMANDS_DIR = File.join(TEMPLATES, ".claude/commands")
INDEX_PATH = File.join(RULES_DIR, "INDEX.md")
IGNORE = "lint-docs:ignore"
REQUIRED_RULE_KEYS = %w[id title applies_to triggers see_also tokens].freeze
WORDS_PER_TOKEN = 0.75 # rough, so index self-cost is checked as a band not a value
MAX_DESCRIPTION = 80 # a picker line, not a paragraph

findings = []
def rel(path) = path.sub("#{ROOT}/", "")

index = File.read(INDEX_PATH)
rule_paths = Dir.glob(File.join(RULES_DIR, "*.md")).reject { |p| File.basename(p) == "INDEX.md" }.sort
command_paths = Dir.glob(File.join(COMMANDS_DIR, "*.md")).sort

# --- 1. Rule frontmatter -----------------------------------------------------
# Six keys, and `id` matching the filename, because every other file references
# a rule by id.
declared_tokens = {}
rule_paths.each do |path|
  id = File.basename(path, ".md")
  body = File.read(path)
  raw = body[/\A---\n(.*?)\n---\n/m, 1]
  next findings << "#{rel(path)}: no YAML frontmatter" if raw.nil?

  fm = begin
    YAML.safe_load(raw) || {}
  rescue Psych::SyntaxError => e
    findings << "#{rel(path)}: unparseable frontmatter (#{e.message})"
    next
  end

  missing = REQUIRED_RULE_KEYS - fm.keys
  findings << "#{rel(path)}: frontmatter missing #{missing.join(', ')}" if missing.any?
  findings << "#{rel(path)}: id is #{fm['id'].inspect}, filename says #{id.inspect}" if fm["id"] != id
  declared_tokens[id] = fm["tokens"]
end

# --- 2. Index routing --------------------------------------------------------
# INDEX.md's own maintenance rule: a new rule gets a row in all three tables.
sections = index.split(/^## /).each_with_object({}) do |chunk, acc|
  title = chunk.lines.first.to_s.strip
  acc[title] = chunk
end
path_table = sections["Route by path"].to_s
symptom_table = sections["Route by symptom"].to_s
full_list = sections["Full list"].to_s

rule_paths.each do |path|
  id = File.basename(path, ".md")
  link = "(#{id}.md)"
  findings << "INDEX.md: #{id} missing from 'Route by path'" unless path_table.include?(link)
  findings << "INDEX.md: #{id} missing from 'Route by symptom'" unless symptom_table.include?(link)

  row = full_list[/^\|\s*\[#{Regexp.escape(id)}\]\(#{Regexp.escape(id)}\.md\)\s*\|\s*(\d+)\s*\|/, 1]
  if row.nil?
    findings << "INDEX.md: #{id} missing from 'Full list'"
  elsif row.to_i != declared_tokens[id]
    findings << "INDEX.md: #{id} row says #{row} tokens, the file declares #{declared_tokens[id]}"
  end
end

orphans = full_list.scan(/^\|\s*\[([a-z0-9-]+)\]\(\1\.md\)/).flatten - rule_paths.map { |p| File.basename(p, ".md") }
orphans.each { |id| findings << "INDEX.md: 'Full list' has a row for #{id}, which has no rule file" }

# --- 3. Read-cost figures ----------------------------------------------------
# These are the only read-cost numbers in the repo, and the architecture asks an
# agent to budget from them, so they have to be true.
sum = declared_tokens.values.compact.sum
claimed_sum = index[/\*\*Total corpus:\*\* ~([\d,]+) tokens across (\d+) rules/, 1]&.delete(",")&.to_i
claimed_count = index[/\*\*Total corpus:\*\* ~[\d,]+ tokens across (\d+) rules/, 1].to_i
if claimed_sum.nil?
  findings << "INDEX.md: no 'Total corpus' line to check"
else
  findings << "INDEX.md: corpus claims ~#{claimed_sum} tokens, rules declare #{sum}" if (claimed_sum - sum).abs > 100
  findings << "INDEX.md: corpus claims #{claimed_count} rules, there are #{rule_paths.size}" if claimed_count != rule_paths.size
end

lo, hi = declared_tokens.values.compact.minmax
claimed_lo = index[/plus one or two rules \((\d+)[–-](\d+)\)/, 1]&.to_i
claimed_hi = index[/plus one or two rules \((\d+)[–-](\d+)\)/, 2]&.to_i
if claimed_lo && (claimed_lo != lo || claimed_hi != hi)
  findings << "INDEX.md: per-rule range claims #{claimed_lo}-#{claimed_hi}, actual #{lo}-#{hi}"
end

claimed_index = index[/this index \(~([\d,]+)\)/, 1]&.delete(",")&.to_i
estimated_index = (index.split.size / WORDS_PER_TOKEN).round(-2)
if claimed_index && (claimed_index - estimated_index).abs > estimated_index * 0.2
  findings << "INDEX.md: claims ~#{claimed_index} tokens for itself, estimate is ~#{estimated_index}"
end

# --- 4. Wizard token coverage ------------------------------------------------
# A {{TOKEN}} nobody fills ships to a generated app as literal braces.
wizard = File.read(File.join(COMMANDS_DIR, "workflow_setup.md"))
command_paths.flat_map { |p| File.read(p).scan(/\{\{[A-Z_]+\}\}/) }.uniq.sort.each do |token|
  findings << "workflow_setup.md never mentions #{token}, so nothing fills it" unless wizard.include?(token)
end

# --- 5. Paths referenced by commands ----------------------------------------
# Every path-shaped `.md` reference in a command has to resolve inside
# templates/, which is what makes the `task_template.llm.md` class of bug
# visible. A reference naming a file the workflow writes at runtime carries a
# placeholder (`<id>`, a date, a glob), and those are skipped: the path is a
# pattern, not a file. A bare basename with no directory is a name in prose.
PLACEHOLDER = /[<>*$]|YYYY|\{\{/
command_paths.each do |path|
  File.readlines(path).each_with_index do |line, i|
    next if line.include?(IGNORE) # a file this command creates at runtime

    line.scan(%r{[\w.][\w./-]*\.md}).uniq.each do |ref|
      next if ref.match?(PLACEHOLDER) || ref.start_with?("http", "../")
      next unless ref.include?("/") # a bare basename in prose is a name, not a path

      target = File.join(TEMPLATES, ref)
      next if File.exist?(target) || File.exist?("#{target}.tt")

      findings << "#{rel(path)}:#{i + 1}: references #{ref}, which does not exist under templates/"
    end
  end
end

# --- 6. Command routers ------------------------------------------------------
# A router that omits a command is a router that lies.
agents_md = File.read(File.join(TEMPLATES, "AGENTS.md"))
workflow_md = File.read(File.join(TEMPLATES, "WORKFLOW.md"))
command_paths.each do |path|
  name = File.basename(path, ".md")
  findings << "templates/AGENTS.md: no entry for /#{name}" unless agents_md.include?(name)
  findings << "templates/WORKFLOW.md: 'Command inventory' has no entry for /#{name}" unless workflow_md.include?(name)
end

# --- 7. Command frontmatter -------------------------------------------------
# A command's `description` is what a picker shows a human deciding whether to
# run it, so it is the routing surface, not decoration. `argument-hint` is
# required wherever the body reads $ARGUMENTS. Values are quoted because a
# description with a colon, or a hint in brackets, otherwise parses as a map or
# a list rather than a string.
command_names = command_paths.map { |p| File.basename(p, ".md") }
command_paths.each do |path|
  name = File.basename(path, ".md")
  body = File.read(path)
  raw = body[/\A---\n(.*?)\n---\n/m, 1]

  if raw.nil?
    findings << "#{rel(path)}: no frontmatter, so no description for a picker to show"
  else
    fm = begin
      YAML.safe_load(raw) || {}
    rescue Psych::SyntaxError => e
      findings << "#{rel(path)}: unparseable frontmatter (#{e.message})"
      {}
    end

    fm.each do |key, value|
      next if value.is_a?(String)

      findings << "#{rel(path)}: #{key} parses as #{value.class}, not a string (quote the value)"
    end

    description = fm["description"].to_s
    findings << "#{rel(path)}: frontmatter has no description" if description.empty?
    findings << "#{rel(path)}: description is #{description.length} chars, keep it under #{MAX_DESCRIPTION}" if description.length > MAX_DESCRIPTION
    if description.match?(/\Ause when|\Athis (command|skill)|\Ainvoke/i)
      findings << "#{rel(path)}: description opens with trigger phrasing; a human reads it in a picker, so state the job"
    end
    if body.include?("$ARGUMENTS") && fm["argument-hint"].to_s.empty?
      findings << "#{rel(path)}: reads $ARGUMENTS but declares no argument-hint"
    end
  end

  # A command that documents itself under a name nobody can type is a router
  # that lies about its own address. Only backticked names are checked: a bare
  # slash is usually a URL path or /dev/null.
  body.scan(/`\/([a-z][a-z0-9_]*)[^`]*`/).flatten.uniq.each do |mentioned|
    next if command_names.include?(mentioned)

    findings << "#{rel(path)}: mentions `/#{mentioned}`, which is not a command"
  end
end

# --- 8. Counts quoted in prose ----------------------------------------------
# Every doc that names a count, anywhere in the repo, against the real one.
COUNT_PATTERNS = [
  [/(\d+)\s+single-rule/, :rules],
  [/(\d+)\s+rules\b/, :rules],
  [/(\d+)\s+(?:workflow |slash )?commands?\b/, :commands]
].freeze

actual = { rules: rule_paths.size, commands: command_paths.size }
Dir.glob(File.join(ROOT, "**/*.{md,tt,rb}")).reject { |p| p.include?("/.git/") }.sort.each do |path|
  File.readlines(path).each_with_index do |line, i|
    next if line.include?(IGNORE)

    COUNT_PATTERNS.each do |pattern, kind|
      claimed = line[pattern, 1]&.to_i
      next if claimed.nil? || claimed == actual[kind]

      findings << "#{rel(path)}:#{i + 1}: claims #{claimed} #{kind}, there are #{actual[kind]}"
    end
  end
end

# --- Report ------------------------------------------------------------------
if findings.empty?
  puts "lint-docs: clean (#{rule_paths.size} rules, #{command_paths.size} commands)"
  exit 0
end

warn "lint-docs: #{findings.size} finding#{'s' unless findings.size == 1}"
findings.uniq.each { |f| warn "  #{f}" }
exit 1
