# Kamal 2 Deployment Configuration
#
# Setup:
# 1. Fill in .kamal/secrets with your deployment secrets
# 2. Update the server IP/hostname below
# 3. Configure your Docker registry credentials
# 4. Run: kamal setup
#
# Deploy: kamal deploy
# Console: kamal console
# Logs: kamal logs

service: <%= app_name %>

# Container image - update with your registry
image: your-username/<%= app_name %>

# Deploy to these servers
servers:
  web:
    hosts:
      - YOUR_SERVER_IP
    options:
      memory: 2g

# Proxy configuration (Kamal 2 uses kamal-proxy)
proxy:
  ssl: true
  host: your-domain.com
  app_port: 3000
  healthcheck:
    path: /up
    interval: 3
    timeout: 3

# Docker registry credentials
# For GitHub Container Registry (ghcr.io):
#   server: ghcr.io
#   username: your-github-username
# For Docker Hub:
#   server: docker.io (or omit)
#   username: your-dockerhub-username
registry:
  server: ghcr.io
  username: your-username
  password:
    - KAMAL_REGISTRY_PASSWORD

# Environment variables
env:
  secret:
    - RAILS_MASTER_KEY
    - DATABASE_URL
    - QUEUE_DATABASE_URL
    - CABLE_DATABASE_URL
    - CACHE_DATABASE_URL
  clear:
    RAILS_ENV: production
    RAILS_LOG_LEVEL: info
    SOLID_QUEUE_IN_PUMA: true
    WEB_CONCURRENCY: 2
    RAILS_MAX_THREADS: 5

# Aliases for common commands
aliases:
  console: app exec --interactive --reuse "bin/rails console"
  shell: app exec --interactive --reuse "bash"
  logs: app logs -f
  dbc: app exec --interactive --reuse "bin/rails dbconsole"

# Persistent storage for uploads
volumes:
  - "<%= app_name %>_storage:/rails/storage"

<% unless API -%>
# Bridge assets between deploys
asset_path: /rails/public/assets
<% else -%>
# No asset_path: an API app compiles no assets, so there is nothing to bridge
# between deploys and naming a directory that stays empty only misleads.
<% end -%>

# Docker build configuration
# Use remote builder to avoid ARM64→x86_64 emulation issues with Tailwind CSS
# See: https://github.com/rails/tailwindcss-rails/discussions/499
builder:
  arch: amd64
  # Uncomment to use remote builder (recommended for Apple Silicon Macs):
  # remote: ssh://root@YOUR_SERVER_IP

# <%= DB_LABEL %> database accessory. The port binds to 127.0.0.1 on purpose:
# see docs/sop/harden-a-kamal-server.md.
accessories:
  db:
    image: <%= DB_ACCESSORY_IMAGE %>
    host: YOUR_SERVER_IP
    port: "127.0.0.1:<%= DB_PORT %>:<%= DB_PORT %>"
    env:
      clear:
<% if POSTGRESQL -%>
        POSTGRES_USER: <%= app_name %>
        POSTGRES_DB: <%= app_name %>_production
      secret:
        - POSTGRES_PASSWORD
    directories:
      - data:/var/lib/postgresql/data
<% else -%>
        MYSQL_USER: <%= app_name %>
        MYSQL_DATABASE: <%= app_name %>_production
      secret:
        # MYSQL_ROOT_PASSWORD is not optional — the official image refuses to
        # initialise without it (or one of the ALLOW_EMPTY/RANDOM opt-outs).
        - MYSQL_PASSWORD
        - MYSQL_ROOT_PASSWORD
    directories:
      - data:/var/lib/mysql
<% end -%>
